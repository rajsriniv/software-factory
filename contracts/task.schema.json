{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/software-factory/task.schema.json",
  "title": "Implementation task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "requirement_ids", "repository", "base_revision", "acceptance_criteria", "allowed_paths", "risk"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "repository": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 7},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk": {"enum": ["low", "medium", "high", "critical"]}
  }
}
