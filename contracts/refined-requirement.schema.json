{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Refined requirement brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "revision", "original_request", "original_sha256", "problem", "outcome", "requirements", "acceptance_criteria", "assumptions", "open_questions", "blocking_decisions", "sources", "change_summary", "readiness"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "original_request": {"type": "string", "minLength": 1},
    "original_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "problem": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "users": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "basis"], "properties": {"id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "basis": {"enum": ["user", "company-source", "proposed-assumption"]}, "source": {"type": "string"}}}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "result", "verification"], "properties": {"requirement_id": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}}}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "blocking_decisions": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source", "revision", "sha256"], "properties": {"source": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "change_summary": {"type": "string"},
    "confirmation_evidence": {"type": "string"},
    "readiness": {"enum": ["needs-clarification", "ready-for-architecture"]}
  },
  "allOf": [{"if": {"properties": {"readiness": {"const": "ready-for-architecture"}}}, "then": {"properties": {"blocking_decisions": {"maxItems": 0}}}}]
}
